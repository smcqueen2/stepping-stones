# Optional public data URL. Leave unset to keep the existing GitHub Pages JSON.
# VITE_DATA_ENDPOINT=https://stepping-stones-data.YOUR-SUBDOMAIN.workers.dev/data/snapshot.json
# Local Worker preview:
# VITE_DATA_ENDPOINT=http://127.0.0.1:8787/data/snapshot.json
# Never put NRW_API_KEY or a Cloudflare API token in a VITE_ variable.
# Community reports: use the local Vite proxy while running npm run reports:dev.
# VITE_REPORTS_ENDPOINT=/api/reports
# Hosted public URL is set by the Pages workflow from REPORTS_ENDPOINT.
