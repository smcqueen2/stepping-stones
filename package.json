{
  "name": "stepping-stones",
  "version": "0.1.0",
  "description": "A site to help inform visitors if the ogmore stepping stones are passable",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "generate:data": "node scripts/generate-all-data.mjs",
    "worker:install": "npm --prefix workers/data-refresh ci",
    "worker:dev": "npm --prefix workers/data-refresh run dev",
    "worker:check": "npm --prefix workers/data-refresh run check",
    "worker:check:ci": "npm --prefix workers/data-refresh run check:ci",
    "worker:deploy": "npm --prefix workers/data-refresh run deploy",
    "worker:deploy:ci": "npm --prefix workers/data-refresh run deploy:ci",
    "calibrate:observations": "node scripts/calibrate-observations.mjs",
    "build:with-data": "npm run generate:data && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smcqueen2/stepping-stones.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/smcqueen2/stepping-stones/issues"
  },
  "homepage": "https://github.com/smcqueen2/stepping-stones#readme",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ogl": "1.0.11",
    "suncalc": "2.1.1"
  }
}
