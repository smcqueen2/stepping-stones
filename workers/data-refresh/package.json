{
  "name": "stepping-stones-data-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --test-scheduled",
    "check": "wrangler deploy --dry-run --outdir dist",
    "check:ci": "node scripts/prepare-ci-config.mjs && wrangler deploy --config wrangler.ci.json --dry-run --outdir dist/ci",
    "deploy": "node scripts/check-deploy-config.mjs && wrangler deploy",
    "deploy:ci": "node scripts/prepare-ci-config.mjs && wrangler deploy --config wrangler.ci.json",
    "logs": "wrangler tail"
  },
  "devDependencies": { "wrangler": "4.158.0" }
}
