{
  "$schema": "../data-refresh/node_modules/wrangler/config-schema.json",
  "name": "stepping-stones-reports-local",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "d1_databases": [{ "binding": "REPORTS", "database_name": "stepping-stones-observations", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "SUBMISSIONS", "namespace_id": "517311", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
    "LOCAL_DEVELOPMENT": "true"
  },
  "observability": { "enabled": false }
}
